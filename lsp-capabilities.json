{
  "schema": "OpenQCLspCapabilities",
  "version": 1,
  "id": "mlip-lsp",
  "software": "mlip",
  "displayName": "MLIP",
  "languageId": "mlip",
  "executable": "mlip-lsp",
  "defaultBranch": "main",
  "filePatterns": [
    "*.mlip.json",
    "*.mlip.yaml",
    "*.mlip.yml",
    "mlip.json",
    "mlip.yaml",
    "mlip.yml"
  ],
  "maturity": "stable",
  "blockingPolicy": {
    "mode": "blocking",
    "description": "Error diagnostics block run-gate and Bohrium submission until resolved."
  },
  "capabilities": [
    "agent-envelope",
    "agent-json-cli",
    "blocking-gate",
    "completion",
    "context",
    "diagnostic-engine-v1",
    "diagnostics",
    "fix-placeholder",
    "fix-preview",
    "hover",
    "llm-wiki",
    "manifest",
    "openqc-context",
    "rich-diagnostics",
    "routing",
    "source-provenance",
    "symbols"
  ],
  "agentCli": {
    "command": "mlip-lsp-tool",
    "operations": [
      "capabilities",
      "check",
      "context",
      "complete",
      "hover",
      "symbols",
      "fix"
    ],
    "jsonFormat": true,
    "failOnBlocking": true
  },
  "diagnosticSchema": "diagnostics/diagnostic-engine-v1.schema.json",
  "wikiPaths": {
    "plan": "docs/LLM-WIKI-PLAN.md",
    "rawAssets": "raw/assets",
    "entities": "wiki/entities",
    "concepts": "wiki/concepts",
    "synthesis": "wiki/synthesis",
    "index": "index.md",
    "log": "log.md"
  },
  "fixturePaths": {
    "valid": [
      "tests/fixtures/valid",
      "tests/fixtures/preflight/valid_manifest"
    ],
    "invalid": [
      "tests/fixtures/invalid",
      "tests/fixtures/preflight/missing_model_potential"
    ],
    "logs": [
      "tests/fixtures/logs"
    ]
  },
  "outputLogPatterns": [
    "*.log",
    "traceback.log"
  ],
  "diagnostic_coverage": {
    "status": "partial",
    "notes": "Manifest, ASE script, and preflight diagnostics are implemented; exhaustive MLIP version-gated grammar coverage remains in progress (issues #34, #35)."
  },
  "openqc": {
    "registryId": "mlip-lsp",
    "repoName": "mlip-lsp",
    "contextContract": "DSLAuthoringContext",
    "diagnosticEnvelope": "DiagnosticEnvelope/v1"
  },
  "sourceProvenance": [
    {
      "kind": "official_docs",
      "label": "MLIP documentation",
      "url": "https://mlip.skoltech.ru/"
    },
    {
      "kind": "official_examples",
      "label": "MACE training examples",
      "url": "https://github.com/acesuit/mace"
    },
    {
      "kind": "provenance_manifest",
      "label": "MLIP provenance manifest",
      "path": "raw/assets/manifest.json"
    }
  ],
  "llmWiki": {
    "upstreamManifest": "raw/assets/upstream-sources.md",
    "provenanceManifest": "raw/assets/manifest.json",
    "agentContext": "wiki/synthesis/openqc-agent-context.md",
    "diagnosticEngine": "wiki/concepts/diagnostic-engine-v1.md",
    "exampleInputs": [
      "raw/assets/valid_manifest.json",
      "raw/assets/examples/manifest_md.json",
      "raw/assets/valid_ase_script.py"
    ],
    "hoverCorpus": "wiki/entities/MLIP_Manifest.md",
    "operationHints": {
      "check": "wiki/synthesis/Diagnostic_Codes_Reference.md",
      "hover": "wiki/entities/MLIP_Manifest.md",
      "complete": "wiki/synthesis/Input_Format_Reference.md",
      "context": "wiki/synthesis/openqc-agent-context.md"
    }
  }
}
